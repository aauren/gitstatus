#!/bin/sh
#
# This script does not have a stable API.
#
# Unlike upstream, this fork never downloads gitstatusd. install only
# locates a binary that is already on disk, and tells you how to build
# one when there isn't. install.info is kept as-is for the day there is
# CI producing release binaries again, but nothing reads it right now.

_gitstatus_install_daemon_found() {
  local installed="$1"
  shift
  [ $# = 0 ] || "$@" "$daemon" "$version" "$installed"
}

_gitstatus_install_main() {
  if [ -n "${ZSH_VERSION:-}" ]; then
    emulate -L sh -o no_unset
  else
    set -u
  fi

  local argv1="$1"
  shift

  local no_check= no_install= uname_s= uname_m= gitstatus_dir= dl_status= e=
  local opt= OPTARG= OPTIND=1

  while getopts ':s:m:d:p:e:fnh' opt "$@"; do
    case "$opt" in
      h)
        command cat <<\END
Usage: install [-s KERNEL] [-m ARCH] [-d DIR] [-p CMD] [-e ERRFD] [-f|-n] [-- CMD [ARG]...]

If positional arguments are specified, call this on success:

  CMD [ARG]... DAEMON VERSION INSTALLED

DAEMON is path to gitstatusd. VERSION is a glob pattern for the
version this daemon should support; it's supposed to be passed as
-G to gitstatusd. INSTALLED is always 0: this fork never downloads
gitstatusd, it only finds one that is already on disk. In order of
precedence: GITSTATUS_DAEMON, DIR/usrbin/gitstatusd, then
DIR/usrbin/gitstatusd-KERNEL-ARCH.

Options:

  -s KERNEL  use this instead of lowercase `uname -s`
  -m ARCH    use this instead of lowercase `uname -m`
  -d DIR     use this instead of `dirname "$0"`
  -p CMD     accepted for compatibility and ignored
  -e ERRFD   write error messages to this file descriptor
  -f         accepted for compatibility and ignored
  -n         print a terse error instead of build instructions
END
        return
      ;;
      n)
        if [ -n "$no_install" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        no_install=1
      ;;
      f)
        if [ -n "$no_check" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        no_check=1
      ;;
      d)
        if [ -n "$gitstatus_dir" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        if [ -z "$OPTARG" ]; then
          >&2 echo "[error] incorrect value of -$opt: $OPTARG"
          return 1
        fi
        gitstatus_dir="$OPTARG"
      ;;
      p)
        if [ -n "$dl_status" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        if [ -z "$OPTARG" ]; then
          >&2 echo "[error] incorrect value of -$opt: $OPTARG"
          return 1
        fi
        dl_status="$OPTARG"
      ;;
      e)
        if [ -n "$e" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        if [ -z "$OPTARG" ]; then
          >&2 echo "[error] incorrect value of -$opt: $OPTARG"
          return 1
        fi
        e="$OPTARG"
      ;;
      m)
        if [ -n "$uname_m" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        if [ -z "$OPTARG" ]; then
          >&2 echo "[error] incorrect value of -$opt: $OPTARG"
          return 1
        fi
        uname_m="$OPTARG"
      ;;
      s)
        if [ -n "$uname_s" ]; then
          >&2 echo "[gitstatus] error: duplicate option: -$opt"
          return 1
        fi
        if [ -z "$OPTARG" ]; then
          >&2 echo "[error] incorrect value of -$opt: $OPTARG"
          return 1
        fi
        uname_s="$OPTARG"
      ;;
      \?) >&2 echo "[gitstatus] error: invalid option: -$OPTARG"           ; return 1;;
      :)  >&2 echo "[gitstatus] error: missing required argument: -$OPTARG"; return 1;;
      *)  >&2 echo "[gitstatus] internal error: unhandled option: -$opt"   ; return 1;;
    esac
  done

  shift "$((OPTIND - 1))"

  : "${e:=2}"
  : "${gitstatus_dir:=$argv1}"

  if [ -n "$no_check" -a -n "$no_install" ]; then
    >&2 echo "[gitstatus] error: incompatible options: -f, -n"
    return 1
  fi

  if [ -z "$uname_s" ]; then
    uname_s="$(command uname -s)" || return
    uname_s="$(printf '%s' "$uname_s" | command tr '[A-Z]' '[a-z]')" || return
  fi
  if [ -z "$uname_m" ]; then
    uname_m="$(command uname -m)" || return
    uname_m="$(printf '%s' "$uname_m" | command tr '[A-Z]' '[a-z]')" || return
  fi

  local daemon="${GITSTATUS_DAEMON:-}"

  if [ -n "${daemon##/*}" ]; then
    >&2 echo "[gitstatus] error: GITSTATUS_DAEMON is not absolute path: $daemon"
    return 1
  fi
  # In order of precedence: GITSTATUS_DAEMON, the binary ./build leaves in
  # usrbin, then one named by kernel and arch for checkouts shared between machines
  if [ -z "$daemon" -a -e "$gitstatus_dir"/usrbin/gitstatusd ]; then
    daemon="$gitstatus_dir"/usrbin/gitstatusd
  fi
  if [ -z "$daemon" -a -e "$gitstatus_dir"/usrbin/gitstatusd-"$uname_s"-"$uname_m" ]; then
    daemon="$gitstatus_dir"/usrbin/gitstatusd-"$uname_s"-"$uname_m"
  fi

  if [ -n "$daemon" ]; then
    local gitstatus_version= libgit2_version=
    if ! . "$gitstatus_dir"/build.info; then
      >&2 echo "[gitstatus] internal error: failed to source build.info"
      return 1
    fi
    if [ -z "$gitstatus_version" ]; then
      >&2 echo "[gitstatus] internal error: empty gitstatus_version in build.info"
      return 1
    fi
    local version="$gitstatus_version"
    _gitstatus_install_daemon_found 0 "$@"
    return
  fi

  if [ -n "$no_install" ]; then
    >&2 echo "[gitstatus] error: no gitstatusd found and installation is disabled"
    return 1
  fi

  >&"$e" printf 'No \033[32mgitstatusd\033[0m binary found for \033[1m%s\033[0m.\n' "$uname_s $uname_m"
  >&"$e" printf '\n'
  >&"$e" printf 'This fork of gitstatus has no prebuilt binaries and never downloads any.\n'
  >&"$e" printf 'Build one from the checkout the shell bindings were loaded from:\n'
  >&"$e" printf '\n'
  >&"$e" printf '  \033[32mcd\033[0m %s \033[32m&&\033[0m ./build -w -s -d docker\n' "$gitstatus_dir"
  >&"$e" printf '\n'
  >&"$e" printf 'Drop \033[1m-d docker\033[0m or \033[1m-s\033[0m if the script says they are not supported here.\n'
  >&"$e" printf 'The result lands in \033[4m%s/usrbin/gitstatusd\033[0m\n' "$gitstatus_dir"
  >&"$e" printf 'and is picked up the next time the shell starts. To use a binary built\n'
  >&"$e" printf 'elsewhere, export \033[1mGITSTATUS_DAEMON\033[0m with its absolute path instead.\n'
  >&"$e" printf '\n'
  >&"$e" printf 'See: \033[4mhttps://github.com/aauren/gitstatus#compiling\033[0m\n'
  return 1
}

if [ -z "${0##*/*}" ]; then
  _gitstatus_install_main "${0%/*}" "$@"
else
  _gitstatus_install_main . "$@"
fi
